ENVIRONMENT=development

DB_HOST=news-db
DB_PORT=5432
DB_NAME=news_pipeline
DB_USER=news
DB_PASSWORD=news

# Next.js moves to 3001 when 3000 is already taken, and a browser at
# 127.0.0.1 sends a different origin than one at localhost. An origin missing
# from this list appears in the browser as "Failed to fetch".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

AIRFLOW_BASE_URL=http://airflow-apiserver:8080
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

ADMIN_API_KEY=changeme
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=NewsLens Admin
AUTH_SECRET=change-this-to-a-long-random-value

# Transactional email over SMTP. Leave SMTP_USER/SMTP_PASSWORD empty and
# messages are written to the application log instead of sent — the backend
# runs fine without credentials, and development never mails a real person.
#
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, NOT the
# account password. To create one: turn on 2-Step Verification in your Google
# Account, then Security -> App passwords. Paste it here without spaces.
# Gmail ignores any other From address and sends as SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=NewsLens
SITE_URL=http://localhost:3000
